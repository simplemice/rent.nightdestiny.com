# Apache config for rent.nightdestiny.com  (REVIEW BEFORE DEPLOY — tested locally with php:8.3-apache only)
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Canonical host + HTTPS (301). Works behind a proxy/CDN that sets X-Forwarded-Proto; no loops. ---
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://rent.nightdestiny.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.rent\.nightdestiny\.com$ [NC]
RewriteRule ^ https://rent.nightdestiny.com%{REQUEST_URI} [L,R=301]

# --- /index.php -> / (no duplicate home URL) ---
RewriteCond %{THE_REQUEST} \s/index\.php[\s?]
RewriteRule ^index\.php$ / [L,R=301]

# --- sitemap.xml is generated; hide the script URL ---
RewriteCond %{THE_REQUEST} \s/sitemap\.php[\s?]
RewriteRule ^sitemap\.php$ /sitemap.xml [L,R=301]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# --- Never serve logs, backups, VCS, config ---
<FilesMatch "^(error_log|composer\.(json|lock)|README\.md|.*\.(md|tgz|log|bak|sql))$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.(git|env|ht)">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml font/ttf font/otf
</IfModule>

# --- Browser caching for static assets (HTML/PHP stay uncached so prices/availability are never stale) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
